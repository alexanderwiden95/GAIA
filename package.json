{
  "name": "gaia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && npm start",
    "migrate": "node --env-file-if-exists=.env src/db.ts migrate",
    "protocol:generate": "codex app-server generate-ts --out src/protocol",
    "spike": "node src/codex-spike.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --test tests/db.integration.ts",
    "test:agents": "node tests/agents.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.0"
  }
}
