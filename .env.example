# Discord snowflakes from Developer Mode. Separate channel IDs with commas.
GAIA_OWNER_ID=
GAIA_GUILD_ID=
GAIA_CHANNEL_IDS=

# Prefer Keychain. This fallback is only for the ignored local .env file.
GAIA_DISCORD_TOKEN=

# The default matches compose.yaml.
DATABASE_URL=postgresql://gaia:gaia-local@127.0.0.1:5432/gaia

# Optional local embedding model override. Changing dimensions requires a migration.
GAIA_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Required proactive delivery settings. The channel must also be in GAIA_CHANNEL_IDS.
GAIA_PROACTIVE_CHANNEL_ID=
GAIA_TIMEZONE=Europe/Stockholm
GAIA_DAILY_DIGEST_TIME=08:30
GAIA_QUIET_HOURS_START=22:00
GAIA_QUIET_HOURS_END=07:00
