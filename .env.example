# Discord snowflakes from Developer Mode. Separate channel IDs with commas.
GAIA_OWNER_ID=
GAIA_GUILD_ID=
GAIA_CHANNEL_IDS=

# Prefer Keychain. This fallback is only for the ignored local .env file.
GAIA_DISCORD_TOKEN=

# The default matches compose.yaml.
DATABASE_URL=postgresql://gaia:gaia-local@127.0.0.1:5432/gaia
